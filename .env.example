# ─────────────────────────────────────────────────────────────
#  ClipVein configuration — copy this file to `.env` and edit.
#  Nothing here is required to run in browser mode. Keys only
#  unlock the optional Grok / Claude enrichment steps.
# ─────────────────────────────────────────────────────────────

# How ClipVein reads the X feed.
#   browser  → attach to YOUR already-open Chrome and read the live feed (default, no keys)
#   grok     → ask Grok (xAI) to surface top posts        (needs XAI_API_KEY)
#   mock     → run on bundled sample data, no network      (great for demos/dev)
CLIPVEIN_SOURCE=browser

# Chrome remote-debugging endpoint ClipVein attaches to in browser mode.
# Start Chrome once with:  chrome --remote-debugging-port=9222
CHROME_CDP_URL=http://127.0.0.1:9222

# Minimum views for a post to even be considered "interesting".
CLIPVEIN_MIN_VIEWS=50000

# How many candidate links to surface per search (the UI shows the top 3).
CLIPVEIN_TOP_N=3

# ── Optional: Grok (xAI) — feed discovery + ranking assist ──
# https://console.x.ai  →  API Keys
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# ── Optional: Claude (Anthropic) — caption / post generation ──
# https://console.anthropic.com  →  API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
